@article{Strubbe2015,
  author = {Strübbe, Simon and Stürzl, Wolfgang and Egelhaaf, Martin},
  title = {{Insect-Inspired Self-Motion Estimation with Dense Flow Fields—An Adaptive Matched Filter Approach}},
  year = {2015},
  month = {08},
  journal = {PLOS ONE},
  volume = {10},
  number = {8},
  eid = {e0128413},
  publisher = {Public Library of Science (PLoS)},
  doi = {10.1371/journal.pone.0128413},
  url = {https://doi.org/10.1371/journal.pone.0128413},
  urldate = {2026-11-26},
  language = {en},
  abstract = {文章比较昆虫启发的匹配滤波自运动估计与Koenderink–van Doorn算法，证明在环境距离已知的特定条件下，两者是不同表达形式的等价线性估计器。距离未知时，需要联合估计环境结构与自运动，问题变为非线性。作者分析标准最小均方方案的偏差，提出修正方法并以数值模拟检验性能。对于接近球形的视野，文章进一步简化深度结构表示，形成自适应匹配滤波方法，仅需记忆和更新八个环境参数，以支持自运动过程中的估计。}
}

@phdthesis{Strubbe2019,
  author = {Strübbe, Simon},
  title = {{Insect-Inspired Visual Self-Motion Estimation}},
  year = {2019},
  publisher = {Universität Bielefeld},
  school = {Universität Bielefeld},
  doi = {10.4119/unibi/2934904},
  url = {https://doi.org/10.4119/unibi/2934904},
  urldate = {2026-11-26},
  language = {en},
  note = {Dissertation cover dated November 2018; repository publication year 2019.},
  abstract = {论文比较昆虫启发的匹配滤波法与 Koenderink–van Doorn 自运动估计，讨论已知深度条件下的共同线性结构及未知深度引起的偏差，并提出随运动更新环境深度模型的自适应方法。研究用低阶球谐函数压缩球面视野中的深度信息，在仿真中比较固定和自适应深度模型。总结指出，受限视野与非线性估计最优性仍待研究；在非对称环境且旋转、平移同时存在时，所测试的 Reichardt–Hassenstein 检测器产生较大误差，因此图像仿真采用 Lucas–Kanade 检测器。}
}


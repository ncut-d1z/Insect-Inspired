  booktitle = {Advances in Neural Information Processing Systems},
  volume = {15},
  pages = {1343--1350},
  publisher = {MIT Press},
  url = {https://proceedings.neurips.cc/paper_files/paper/2002/hash/df1f1d20ee86704251795841e6a9405a-Abstract.html},
  urldate = {2026-11-26},
  language = {en},
  note = {Conference year and pages follow official NeurIPS metadata; alternative institutional pagination is recorded in the audit data.},
  abstract = {研究考察蝇脑切向神经元的简化线性模型，能否由光流估计自身运动。作者提出由局部光流向量线性组合构成的估计器，并在构造中同时利用环境距离分布、传感器噪声和自运动统计的先验知识。估计器在携带全景视觉传感器的运动平台上接受实测。结果表明，该方法可产生较准确且稳健的旋转速率估计，而平移估计的可靠性较低。研究把神经元对典型自运动光流模式的选择性与实际运动估计联系起来。}
}

@article{Franz2004,

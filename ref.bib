  urldate = {2026-11-26},
  language = {en},
  note = {Bibliographic metadata describe the published article; supplied file is an author-formatted manuscript.},
  abstract = {研究考察以丽蝇切向神经元组织原则建立的简化线性模型能否从光流估计自运动。作者构建由局部光流向量线性组合构成的估计器，在权重设计中纳入环境距离分布、传感器噪声和自运动统计的先验知识。该方法随后在装有全向视觉传感器的运动平台上接受实验测试。摘要报告旋转速率估计具有较好的准确性和稳健性，平移估计也达到合理质量，但可靠性低于旋转估计。文章由此探索生物视觉组织原则在实际自运动估计中的应用。}
}

@article{Haag2004,
  author = {Haag, Juergen and Borst, Alexander},
  title = {{Neural mechanism underlying complex receptive field properties of motion-sensitive interneurons}},
  year = {2004},
  month = {05},
  journal = {Nature Neuroscience},
  volume = {7},
  number = {6},
  pages = {628--634},
  publisher = {Springer Science and Business Media LLC},
  doi = {10.1038/nn1245},
  url = {https://doi.org/10.1038/nn1245},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究丽蝇垂直系统细胞复杂的局部方向选择性如何由神经回路产生。成对记录显示VS细胞存在电耦合，这种连接可解释感受野沿水平方向的扩展。具有侧方感受野的细胞还与前方感受野VS细胞及水平系统连接，从而形成对旋转光流的选择性。作者将感受野来源分为两部分：一部分是树突接收的局部运动检测器输入，另一部分是通过其他广域神经元的连接导入的运动信息。}
}

@article{Karmeier2005,
  author = {Karmeier, Katja and Krapp, Holger G. and Egelhaaf, Martin},
  title = {{Population Coding of Self-Motion: Applying Bayesian Analysis to a Population of Visual Interneurons in the Fly}},
  year = {2005},
  month = {09},
  journal = {Journal of Neurophysiology},
  volume = {94},
  number = {3},
  pages = {2182--2194},
  publisher = {American Physiological Society},
  doi = {10.1152/jn.00278.2005},
  url = {https://doi.org/10.1152/jn.00278.2005},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究结合丽蝇十个垂直系统视觉中间神经元的电生理参数与群体响应模型，用贝叶斯分析评估水平面内旋转轴编码。分析比较积分时间、参与神经元数量及噪声相关性的作用。结果显示响应开始后约5毫秒的短时间积分已可支持较准确的轴解码，所测试的噪声相关性影响较小。虽然两个神经元在原则上足以编码水平旋转轴，十细胞群体在短积分条件下更有优势，这与快速飞行机动的控制需求相联系。}
}

@article{Kern2005,
  author = {Kern, Roland and van Hateren, J. H. and Michaelis, Christian and Lindemann, Jens Peter and Egelhaaf, Martin},
  title = {{Function of a Fly Motion-Sensitive Neuron Matches Eye Movements during Free Flight}},
  year = {2005},
  month = {05},
  journal = {PLoS Biology},
  volume = {3},
  number = {6},
  eid = {e171},
  publisher = {Public Library of Science (PLoS)},
  doi = {10.1371/journal.pbio.0030171},
  url = {https://doi.org/10.1371/journal.pbio.0030171},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究把自由飞行丽蝇的头部和身体运动所产生的自然光流重新呈现给动物，记录HSE运动敏感神经元的响应，以考察主动凝视策略与视觉计算的关系。结果表明，扫视间期的稳定凝视使平移光流主要处于低频，而残余头部转动较小且频率较高，神经元可据此提取与环境空间布局有关的信息。文章指出，基于行为生成刺激得到的神经功能解释，与传统刺激下把HSE主要视作偏航旋转检测器的解释不同。该结果依赖相应飞行动态与刺激条件。}
}

@article{Kern2012,
  author = {Kern, Roland and Boeddeker, Norbert and Dittmar, Laura and Egelhaaf, Martin},
  title = {{Blowfly flight characteristics are shaped by environmental features and controlled by optic flow information}},
  year = {2012},
  month = {07},
  journal = {Journal of Experimental Biology},
  volume = {215},
  number = {14},
  pages = {2501--2514},
  publisher = {The Company of Biologists},
  doi = {10.1242/jeb.061713},
  url = {https://doi.org/10.1242/jeb.061713},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究通过改变飞行通道宽度及障碍布局，测量丽蝇扫视转向与扫视间平移的控制规律。丽蝇即使在直通道内也采用蜿蜒轨迹，飞行速度及横向摆动幅度随通道宽度增大。扫视持续时间相对稳定，而峰值角速度、频率、幅度和转向序列受环境影响；扫视频率与幅度还与到墙的接触时间相关。结果支持扫视和速度控制主要利用眼前方视区的扫视间光流，而非前进飞行时光流通常最强的侧方视区。}
}

@article{Li2021,
  author = {Li, Jinglin and Niemeier, Miriam and Kern, Roland and Egelhaaf, Martin},
  title = {{Disentangling of Local and Wide-Field Motion Adaptation}},
  year = {2021},
  month = {08},
  journal = {Frontiers in Neural Circuits},
  volume = {15},
  eid = {713285},
  publisher = {Frontiers Media SA},
  doi = {10.3389/fncir.2021.713285},
  url = {https://doi.org/10.3389/fncir.2021.713285},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究设计总体刺激强度相同、局部适应效应不同的两类运动刺激，以分离丽蝇局部运动检测阶段与广域HSE神经元的适应。作者用细胞内记录和视觉运动通路计算模型比较两类刺激下的响应。广域适应明显依赖细胞激活程度及运动方向；局部适应则在不同方向上以相近程度降低响应增益。作者讨论这种方向相对独立的局部适应可能源于不同偏好方向的局部神经元联合活动，有助于表示不依赖全局运动方向的局部运动方向。}
}

@article{Lindemann2005,
  author = {Lindemann, J. P. and Kern, R. and van Hateren, J. H. and Ritter, H. and Egelhaaf, M.},
  title = {{On the Computations Analyzing Natural Optic Flow: Quantitative Model Analysis of the Blowfly Motion Vision Pathway}},
  year = {2005},
  month = {07},
  journal = {The Journal of Neuroscience},
  volume = {25},
  number = {27},
  pages = {6435--6448},
  publisher = {Society for Neuroscience},
  doi = {10.1523/jneurosci.1132-05.2005},
  url = {https://doi.org/10.1523/jneurosci.1132-05.2005},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究构建丽蝇运动视觉通路的计算模型，检验由人工简单刺激建立的机制能否预测自由飞行中复杂自然光流引发的神经响应。模型利用扫视与扫视间期的主动凝视策略，在扫视间期提取与平移速度及环境空间布局有关的信息。作者逐步拆解模型以识别关键环节，并比较自然刺激与简单刺激下的参数敏感性。摘要报告模型对自然刺激的预测较稳健，不同自然光流片段的参数优化没有显示持续刺激期间明显的参数适应变化。}
}

@article{Schwegmann2014,
  author = {Schwegmann, Alexander and Lindemann, Jens P. and Egelhaaf, Martin},
  title = {{Depth information in natural environments derived from optic flow by insect motion detection system: a model analysis}},
  year = {2014},
  month = {08},
  journal = {Frontiers in Computational Neuroscience},
  volume = {8},
  eid = {83},
  publisher = {Frontiers Media SA},
  doi = {10.3389/fncom.2014.00083},
  url = {https://doi.org/10.3389/fncom.2014.00083},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究利用在自然杂乱环境中记录的图像序列，检验昆虫相关型基本运动检测器（EMD）能表达何种深度信息。作者采用经实验检验的运动视觉通路模型，分析不同环境深度结构和空间汇聚尺度下的响应，并通过消除序列中的深度结构进行对照。主要结果是：在近似恒速平移条件下，EMD响应的绝对值，即运动能量分布，反映由图像对比度加权的邻近度，突出近处物体的轮廓。文章据此认为，EMD对速度和纹理的共同依赖有助于简洁表达与行为相关的环境信息。}
}

@article{Strubbe2015,
  author = {Strübbe, Simon and Stürzl, Wolfgang and Egelhaaf, Martin},
  title = {{Insect-Inspired Self-Motion Estimation with Dense Flow Fields—An Adaptive Matched Filter Approach}},
  year = {2015},
  month = {08},
  journal = {PLOS ONE},
  volume = {10},
  number = {8},
  eid = {e0128413},
  publisher = {Public Library of Science (PLoS)},
  doi = {10.1371/journal.pone.0128413},
  url = {https://doi.org/10.1371/journal.pone.0128413},
  urldate = {2026-11-26},
  language = {en},
  abstract = {文章比较昆虫启发的匹配滤波自运动估计与Koenderink–van Doorn算法，证明在环境距离已知的特定条件下，两者是不同表达形式的等价线性估计器。距离未知时，需要联合估计环境结构与自运动，问题变为非线性。作者分析标准最小均方方案的偏差，提出修正方法并以数值模拟检验性能。对于接近球形的视野，文章进一步简化深度结构表示，形成自适应匹配滤波方法，仅需记忆和更新八个环境参数，以支持自运动过程中的估计。}
}


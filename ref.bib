@article{Brinkworth2009,
  author = {Brinkworth, Russell S. A. and O’Carroll, David C.},
  title = {{Robust Models for Optic Flow Coding in Natural Scenes Inspired by Insect Biology}},
  year = {2009},
  month = {11},
  journal = {PLoS Computational Biology},
  volume = {5},
  number = {11},
  eid = {e1000555},
  publisher = {Public Library of Science (PLoS)},
  doi = {10.1371/journal.pcbi.1000555},
  url = {https://doi.org/10.1371/journal.pcbi.1000555},
  urldate = {2026-11-26},
  language = {en},
  abstract = {文章针对相关型运动检测器对对比度等图像属性敏感的问题，提出包含多级非线性动态适应环节的模型，各环节依据丽蝇视觉通路中已知或假定的神经响应设计。模型在接近真实的高动态范围条件下，接受不同自然图像、速度和加速度的测试。摘要报告这些环节共同提高了运动编码的稳健性，其整体收益超过单个模块的增量作用，提示处理阶段之间存在非线性交互。作者讨论了数字及模拟神经形态硬件实现，以及微型自主系统、机器人和避障传感器等应用。}
}

@incollection{Dahmen2009,
  author = {Dahmen, Hansjürgen and Millers, Alain and Mallot, Hanspeter A.},
  editor = {Floreano, Dario and Zufferey, Jean-Christophe and Srinivasan, Mandyam V. and Ellington, Charlie},
  title = {{Insect-Inspired Odometry by Optic Flow Recorded with Optical Mouse Chips}},
  year = {2009},
  booktitle = {Flying Insects and Robots},
  pages = {115--126},
  publisher = {Springer Berlin Heidelberg},
  doi = {10.1007/978-3-540-89393-6_9},
  isbn = {978-3-540-89393-6},
  url = {https://doi.org/10.1007/978-3-540-89393-6_9},
  urldate = {2026-11-26},
  language = {en},
  abstract = {该章节受水黾眼结构、视觉行为及光流自运动模拟研究启发，介绍仅依赖光流测量的里程计装置。装置使用配有适当镜头的光学鼠标芯片作为运动传感器，将视线相反的传感器配对安装在传感头上，并使各对光轴尽可能覆盖大的立体角，以获取自运动参数。作者说明传感头的标定过程，并通过室外实验检验运动估计精度。章节强调这种装置具有低成本、轻量和快速响应的特点，把昆虫视觉研究所启发的光流处理思路用于实际传感器系统。}
}

@article{Drews2020,
  author = {Drews, Michael S. and Leonhardt, Aljoscha and Pirogova, Nadezhda and Richter, Florian G. and Schuetzenberger, Anna and Braun, Lukas and Serbe, Etienne and Borst, Alexander},
  title = {{Dynamic Signal Compression for Robust Motion Vision in Flies}},
  year = {2020},
  month = {01},
  journal = {Current Biology},
  volume = {30},
  number = {2},
  pages = {209--221.e8},
  publisher = {Elsevier BV},
  doi = {10.1016/j.cub.2019.10.035},
  url = {https://doi.org/10.1016/j.cub.2019.10.035},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究果蝇视觉系统怎样在自然场景图像统计变化时保持运动速度估计的稳定性。作者系统测量运动检测回路中神经元的功能特征，发现周围区域的对比度会快速压缩局部响应；该压缩具有空间整合性质并依赖神经反馈。将这种动态信号压缩加入处理自然刺激速度估计的卷积网络模型，可缩小现有模型与动物表现之间的差距。研究提出快速调整局部对比度敏感性，是自然视觉条件下获得稳健运动估计的一种机制。}
}

@article{Erginkaya2025,
  author = {Erginkaya, Mert and Cruz, Tomás and Brotas, Margarida and Marques, André and Steck, Kathrin and Nern, Aljoscha and Torrão, Filipa and Varela, Nélia and Bock, Davi D. and Reiser, Michael and Chiappe, M. Eugenia},
  title = {{A competitive disinhibitory network for robust optic flow processing in Drosophila}},
  year = {2025},
  month = {05},
  journal = {Nature Neuroscience},
  volume = {28},
  number = {6},
  pages = {1241--1255},
  publisher = {Springer Science and Business Media LLC},
  doi = {10.1038/s41593-025-01948-9},
  url = {https://doi.org/10.1038/s41593-025-01948-9},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究果蝇如何在强烈的双眼对称平移光流中提取用于转向的旋转信号。作者利用电镜数据重建水平系统细胞的中枢网络，发现汇聚视觉输入、循环抑制中间层与分散输出层。结合双光子成像、GABA受体操控及建模，结果表明侧向去抑制可降低输出对平移的敏感性，同时增强旋转选择性；单侧操控还支持中间神经元及下行输出参与转向。研究据此提出，竞争性去抑制是平移过程中检测旋转运动的关键回路机制。}
}

@article{Farrow2005,
  author = {Farrow, Karl and Borst, Alexander and Haag, Juergen},
  title = {{Sharing Receptive Fields with Your Neighbors: Tuning the Vertical System Cells to Wide Field Motion}},
  year = {2005},
  month = {04},
  journal = {The Journal of Neuroscience},
  volume = {25},
  number = {15},
  pages = {3985--3993},
  publisher = {Society for Neuroscience},
  doi = {10.1523/jneurosci.0168-05.2005},
  url = {https://doi.org/10.1523/jneurosci.0168-05.2005},
  urldate = {2026-11-26},
  language = {en},
  abstract = {研究检验丽蝇垂直系统神经元之间的侧向连接，是否解释感受野宽度超出各自树突直接输入范围的现象。作者对单个VS细胞进行光消融，观察其他细胞的视觉响应变化。消融后，记录细胞的感受野会依被消融细胞位于更前方还是更后方而收窄，变化符合其失去来自被消融细胞及其更远端细胞的视觉信息。结果支持侧向连接是复杂VS感受野的重要组成部分，并补充了各细胞树突接受的直接柱状输入。}
}

@techreport{Franz1998,
  author = {Franz, Matthias O. and Krapp, Holger G.},
  title = {{Wide-Field, Motion-Sensitive Neurons and Optimal Matched Filters for Optic Flow}},
  year = {1998},
  month = {06},
  number = {61},
  publisher = {Max Planck Institute for Biological Cybernetics},
  institution = {Max Planck Institute for Biological Cybernetics},
  url = {https://hdl.handle.net/11858/00-001M-0000-0013-E875-C},
  urldate = {2026-11-26},
  language = {en},
  abstract = {该技术报告提出由局部光流投影的加权组合估计自运动的最优匹配滤波理论，权重的目标是减小估计与真实运动参数之间的差异。方法以“世界模型”纳入环境距离与平移统计先验，并通过模拟考察估计表现。报告把滤波权重分布与丽蝇视觉系统中单个及小群切向神经元的局部运动敏感性比较，发现二者相近，进而讨论感受野对输入噪声和预期平移光流变化的适应意义。局部偏好方向和运动敏感性被解释为对光流自运动估计需求的适应。}
}

@article{Franz2000,
  author = {Franz, Matthias O. and Krapp, Holger G.},
  title = {{Wide-field, motion-sensitive neurons and matched filters for optic flow fields}},
  year = {2000},
  month = {08},
  journal = {Biological Cybernetics},
  volume = {83},
  number = {3},
  pages = {185--197},
  publisher = {Springer Science and Business Media LLC},
  doi = {10.1007/s004220000163},
  url = {https://doi.org/10.1007/s004220000163},
  urldate = {2026-11-26},
  language = {en},
  abstract = {文章将丽蝇垂直系统（VS）神经元实测的局部运动敏感性，与用于处理旋转和平移光流的匹配滤波模型比较。模型通过引入环境距离和自运动统计的“世界模型”，选择权重以降低噪声及不同场景距离变化造成的输出方差。摘要报告，该模型的一个特例能够预测部分VS神经元的局部运动敏感性，提示其感受野组织有助于在不同场景中对同类自运动保持较一致的输出。研究借此解释部分神经元局部敏感性分布与自运动光流模式之间的对应关系。}
}

@inproceedings{Franz2002,
  author = {Franz, Matthias O. and Chahl, Javaan S.},
  editor = {Becker, S. and Thrun, S. and Obermayer, K.},
  title = {{Linear Combinations of Optic Flow Vectors for Estimating Self-Motion - a Real-World Test of a Neural Model}},
